# ⚠️ SECURITY WARNING: Supabase sensitive files (NEVER commit these)
# Contains sensitive credentials, API keys, and deployment configurations
# Committing these files exposes your database and can lead to security breaches
supabase/.env
supabase/.env.local
supabase/.env.production
supabase/functions/.env
supabase/functions/.env.local
supabase/seed.sql.bak
supabase/volumes/
supabase/.branches/
supabase/.temp/

# Supabase local development - ACTUAL files found in project
.supabase/
supabase/.supabase/
**/supabase/.supabase/

# CRITICAL: Supabase CLI generated files with sensitive data
supabase/.temp/
supabase/.temp/*
supabase/config.toml.bak
supabase/config.local.toml

# Supabase local project files (contain project identifiers)
supabase/.temp/project-ref
supabase/.temp/pooler-url  
supabase/.temp/postgres-version
supabase/.temp/gotrue-version
supabase/.temp/rest-version
supabase/.temp/storage-version
supabase/.temp/cli-latest

# Local Supabase credentials (if created manually)
lib/config/supabase_config.dart
lib/core/config/supabase_secrets.dart
supabase_credentials.dart
supabase_keys.dart

# VS Code Supabase launch configurations (may contain credentials)
.vscode/launch.json

# Environment files with Supabase credentials
.env.supabase
.env.supabase.local
supabase.env

# Supabase database dumps and backups
*.sql.backup
supabase_backup_*.sql
database_dump_*.sql

# Supabase Edge Functions deployment artifacts
