# ⚠️ SECURITY WARNING: Supabase sensitive files (NEVER commit these)
# Contains sensitive credentials, API keys, and deployment configurations
# Committing these files exposes your database and can lead to security breaches
supabase/.env
supabase/.env.local
supabase/.env.production
supabase/functions/.env
supabase/functions/.env.local
supabase/seed.sql.bak
supabase/volumes/
supabase/.branches/
supabase/.temp/

# Supabase local development - ACTUAL files found in project
